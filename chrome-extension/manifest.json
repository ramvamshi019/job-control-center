{
  "manifest_version": 3,
  "name": "JCC Autofill",
  "version": "1.1.0",
  "description": "Autofill + auto-log-applied for job applications on Greenhouse, Lever, Ashby, Workday, iCIMS, BambooHR, SmartRecruiters, Workable. Personal use; profile stored locally.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "*://boards.greenhouse.io/*",
    "*://job-boards.greenhouse.io/*",
    "*://jobs.lever.co/*",
    "*://jobs.ashbyhq.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.icims.com/*",
    "*://*.bamboohr.com/*",
    "*://jobs.smartrecruiters.com/*",
    "*://apply.workable.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.sslip.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JCC Autofill"
  },
  "content_scripts": [
    {
      "matches": [
        "*://boards.greenhouse.io/*",
        "*://job-boards.greenhouse.io/*",
        "*://jobs.lever.co/*",
        "*://jobs.ashbyhq.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.icims.com/*",
        "*://*.bamboohr.com/*",
        "*://jobs.smartrecruiters.com/*",
        "*://apply.workable.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
